# Copy to .env (untracked) and fill in. Variables already set in the environment take precedence.
# The ClickHouse HTTP endpoint that holds the Prism index, and its login
PRISM_CH_HOST=http://localhost:8123
PRISM_CH_USER=default
PRISM_CH_PASSWORD=
# Optional: where make_chart uploads chart images (ssh target) and their public base URL
PRISM_CHART_HOST=
PRISM_CHART_URL=
# Optional: ssh target that showcase/publish_pages.sh publishes the interactive pages to
PRISM_PUBLISH_HOST=
